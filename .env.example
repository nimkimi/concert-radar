# Concert Radar — environment template
# Copy this file to .env.local and fill in the values you have.
# Required for #5 (Spotify OAuth) are marked [#5].

# --- Database (Postgres) -------------------------------------------
# On Vercel: provision Vercel Postgres on the project → these vars are
# injected automatically. POSTGRES_PRISMA_URL is the pooled (PgBouncer)
# URL Prisma uses for queries; POSTGRES_URL_NON_POOLING is the direct
# connection used by `prisma db push` / `prisma migrate deploy`.
#
# For local dev: either run docker (`docker run --rm -p 5432:5432 \
# -e POSTGRES_PASSWORD=dev postgres:16`) or use a Neon dev branch, then
# set BOTH variables to that URL.
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# --- NextAuth ------------------------------------------------------
# [#5] openssl rand -hex 32
NEXTAUTH_SECRET=
# [#5] dev URL. Spotify rejects http://localhost — use http://127.0.0.1.
NEXTAUTH_URL=http://127.0.0.1:3000

# --- Spotify OAuth -------------------------------------------------
# [#5] Register at https://developer.spotify.com/dashboard
# Redirect URI must be http://localhost:3000/api/auth/callback/spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Token encryption ----------------------------------------------
# [#5] 64 hex chars = 32 bytes. openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# --- Cron auth (used in #13) ---------------------------------------
CRON_SECRET=

# --- Concert sources -----------------------------------------------
TICKETMASTER_API_KEY=
BANDSINTOWN_APP_ID=concert-radar

# Feature-flagged sources (default off; flip when keys arrive)
ENABLE_SONGKICK=false
SONGKICK_API_KEY=
ENABLE_BILLETTO=false
BILLETTO_API_KEY=

# --- Email (used in #13) -------------------------------------------
RESEND_API_KEY=
RESEND_FROM=alerts@concert-radar.app

# --- Dev only ------------------------------------------------------
# When true, source adapters load fixture JSON instead of hitting live APIs.
SEED_FROM_FIXTURES=false
