# Concert Radar — environment template
# Copy this file to .env.local and fill in the values you have.
# Required for #5 (Spotify OAuth) are marked [#5].

# --- Database ------------------------------------------------------
DATABASE_URL="file:./dev.db"

# --- NextAuth ------------------------------------------------------
# [#5] openssl rand -hex 32
NEXTAUTH_SECRET=
# [#5] dev URL. Spotify rejects http://localhost — use http://127.0.0.1.
NEXTAUTH_URL=http://127.0.0.1:3000

# --- Spotify OAuth -------------------------------------------------
# [#5] Register at https://developer.spotify.com/dashboard
# Redirect URI must be http://localhost:3000/api/auth/callback/spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Token encryption ----------------------------------------------
# [#5] 64 hex chars = 32 bytes. openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# --- Cron auth (used in #13) ---------------------------------------
CRON_SECRET=

# --- Concert sources -----------------------------------------------
TICKETMASTER_API_KEY=
BANDSINTOWN_APP_ID=concert-radar

# Feature-flagged sources (default off; flip when keys arrive)
ENABLE_SONGKICK=false
SONGKICK_API_KEY=
ENABLE_BILLETTO=false
BILLETTO_API_KEY=

# --- Email (used in #13) -------------------------------------------
RESEND_API_KEY=
RESEND_FROM=alerts@concert-radar.app

# --- Dev only ------------------------------------------------------
# When true, source adapters load fixture JSON instead of hitting live APIs.
SEED_FROM_FIXTURES=false
